{
  "name": "kana-master",
  "version": "1.0.0",
  "description": "히라가나·가타가나 완전 학습앱 — Hiragana & Katakana master PWA",
  "private": true,
  "scripts": {
    "dev": "npx serve . -p 3000 --no-clipboard",
    "lint": "npx eslint js/app.js js/modules/*.js --env browser,es2020 --parser-options=ecmaVersion:2020,sourceType:module",
    "size": "node scripts/check-size.js",
    "zip": "node scripts/build-zip.js",
    "check": "npm run lint && npm run size"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "serve": "^14.2.3",
    "archiver": "^7.0.1"
  }
}
